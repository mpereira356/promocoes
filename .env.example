TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Identificador pessoal (numerico positivo), nao o ID do grupo acima.
TELEGRAM_USER_ID=

# direct: busca nas lojas sem chave; brave: integracao opcional com chave.
SEARCH_PROVIDER=direct
SEARCH_API_KEY=
# Opcional: chave própria para descoberta Tavily. Sem chave, usa o modo público limitado.
TAVILY_API_KEY=
# expanded: 48 produtos/loja; quick: 12. A avaliação exige evidência de preço.
PROMOTIONS_DEPTH=expanded
ALLOWED_DOMAINS=kabum.com.br,pichau.com.br,terabyteshop.com.br,mercadolivre.com.br,amazon.com.br,sensetup.com.br,loja.elements.com.br,flexform.com.br,shopee.com.br,magazineluiza.com.br,frigelar.com.br,brastemp.com.br,lacoste.com,patoloco.com.br,atacadao.com.br,extramercado.com.br,mercado.carrefour.com.br,boasupermercados.com.br
DATABASE_PATH=data/monitor.sqlite3
# Opcional; /cep no Telegram salva a preferencia no banco e tem prioridade.
GROCERY_POSTAL_CODE=
# visit: consultar para ir a loja, sem exigir entrega; delivery: exigir entrega.
# /mercados no Telegram salva a escolha no banco e tem prioridade.
GROCERY_MODE=visit
INTERVAL_HOURS=5
REQUEST_DELAY=3
MIN_DROP_BRL=0
MIN_DROP_PERCENT=0
TARGET_PRICE=
PLAYWRIGHT_ENABLED=false
# Opcional: API oficial Mercado Livre apenas para descobrir links.
# Exige aplicativo autorizado; token pode expirar ou nao ter permissao de busca.
MERCADOLIVRE_ACCESS_TOKEN=
# external: indice publico Tavily sem chave (limitado); site: formulario da loja.
MERCADOLIVRE_DISCOVERY=external
